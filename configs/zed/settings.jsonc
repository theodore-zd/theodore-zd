// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "right"
  },
  "languages": {
    "Markdown": {
      "show_edit_predictions": false
    }
  },
  "collaboration_panel": {
    "button": false
  },
  "tab_size": 2,
  "diff_view_style": "split",
  "proxy": "",
  "edit_predictions": {
    "mode": "subtle",
    "provider": "open_ai_compatible_api",
    "open_ai_compatible_api": {
      "api_url": "https://openrouter.ai/api/v1/completions",
      "model": "z-ai/glm-5.3-flash",
      "prompt_format": "glm",
      "max_output_tokens": 1200
    }
  },
  "agent": {
    "flexible": false,
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "default_profile": "yolo",
    "profiles": {
      "yolo": {
        "default_model": {
          "provider": "openrouter",
          "model": "z-ai/glm-5.3-flash",
          "enable_thinking": true,
          "effort": "low"
        },
        "name": "yolo",
        "tools": {
          "ask_user": true,
          "copy_path": true,
          "create_directory": true,
          "delete_path": true,
          "diagnostics": true,
          "edit_file": true,
          "fetch": true,
          "find_path": true,
          "grep": true,
          "list_directory": true,
          "move_path": true,
          "read_file": true,
          "skill": true,
          "spawn_agent": true,
          "terminal": true
        },
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "tool_permissions": {
      "tools": {
        "terminal": {}
      }
    },
    "default_model": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flash",
      "enable_thinking": true,
      "effort": "low"
    },
    "terminal_init_command": "pi",
    "show_turn_stats": true,
    "play_sound_when_agent_done": "never",
    "favorite_models": [],
    "model_parameters": [],
    "auto_compact": {
      "threshold": "20%",
    },
  },
  "cli_default_open_behavior": "existing_window",
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "remote": false,
      "settings": {
        "github_personal_access_token": "$(gh auth token)",
      },
    },
  },
  "ui_font_family": ".ZedMono",
  "buffer_line_height": "standard",
  "buffer_font_weight": 400.0,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "agent_servers": {
    "Oh-My-Pie": {
      "type": "custom",
      "command": "omp"
    }
  },
  "git_panel": {
    "dock": "right",
    "group_by": "none",
    "tree_view": true,
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
}
